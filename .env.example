# ═══════════════════════════════════════════════════════════════
# Java 后端环境变量模板（复制为 .env.test / .env.prod 后填写）
#
# 用途：docker-compose.yml 的 env_file 注入（给 banma-backend 服务）
#       本地 IDE 开发不用本文件 —— 直接在 IDEA Run Configuration
#       的 Environment variables 里配同名变量即可
#
# 分层（与 Python 仓同构，2026-11-11 定稿）：
#   .env        公共项（跨机同步；不含环境差异）
#   .env.test   测试 VM 差异项（compose env_file required:true）
#   .env.prod   生产差异项（7D 前填写）
#   覆盖顺序：compose environment: > .env.{环境} > .env > yaml 默认值
#   .env / .env.test / .env.prod 全部不入库；本文件是模板
# ═══════════════════════════════════════════════════════════════

# ============ 公共段 → 写入 .env ============

# ---- 讯飞星火（原链路，agent_type=XINGCHEN 时使用；7A 后清理）----
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=
XUNFEI_RTA_API_KEY=

# ---- Spring AI（OpenAI 兼容；预留，当前未启用）----
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_BASE_URL=https://api.openai.com
SPRING_AI_OPENAI_MODEL=
SPRING_AI_OPENAI_EMBEDDING_MODEL=
SPRING_AI_OPENAI_TEMPERATURE=

# ---- 邮箱验证码（SMTP，QQ 邮箱；2026-11-11 登录改写）----
MAIL_USERNAME=
MAIL_AUTH_CODE=

# ============ 环境段 → 写入 .env.test / .env.prod ============

# ---- MySQL ----
MYSQL_HOST=                 # test: VM 内网 IP 或 mysql（compose 服务名）；prod: 生产地址
MYSQL_PORT=3306
MYSQL_DATABASE=banma_interview
MYSQL_USERNAME=root
MYSQL_PASSWORD=             # 必填，yaml 已无默认值

# ---- MongoDB ----
MONGODB_HOST=               # test: mongo（服务名）；prod: 生产地址
MONGODB_PORT=27017
MONGODB_DATABASE=banma_interview
MONGODB_USERNAME=           # 未启用认证则留空
MONGODB_PASSWORD=

# ---- Redis ----
REDIS_HOST=                 # test: redis（服务名）；prod: 生产地址
REDIS_PORT=6379
REDIS_PASSWORD=             # 未设密码留空

# ---- 应用运行时 ----
SERVER_PORT=8002
APP_TIMEZONE=Asia/Shanghai
# 环境激活（compose 里 environment: 已写死对应值，此处仅本地参考）
# SPRING_PROFILES_ACTIVE=test
